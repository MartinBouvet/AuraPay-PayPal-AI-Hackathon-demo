# REST app credentials. Never prefix the secret with NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional. Leave empty for local development without a tunnel.
# The PayPal webhook simulator uses the literal value WEBHOOK_ID.
PAYPAL_WEBHOOK_ID=

PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Business sandbox account allowed to issue Invoicing v2 invoices.
PAYPAL_MERCHANT_EMAIL=

# Personal sandbox account (sb-…@personal.example.com) that receives milestone payouts
# when a quote names a placeholder address such as name@example.com.
PAYPAL_SAMPLE_PAYOUT_RECIPIENT=
